# Copy to .env for local development. Never commit .env.

# Neon connection string. Use a development branch locally, not production.
# Leave unset locally to use a throwaway in-memory store.
DATABASE_URL=

# GitHub OAuth app for local development
# (callback URL: http://localhost:3000/api/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random string, at least 32 characters: openssl rand -base64 32
AUTH_SECRET=

# Comma-separated numeric GitHub user ids allowed to sign in.
# 86918643 = bear7066, 99878260 = THChou1220, 91186819 = GNITOAHC
ALLOWED_GITHUB_IDS=86918643,99878260,91186819

# Optional: run the Neon DocStore contract tests against this database (use a test branch)
TEST_DATABASE_URL=
